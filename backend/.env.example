# Backend – Variables d'environnement
# ⚠️  Ne jamais commiter ce fichier dans Git. Il est dans .gitignore.

# MongoDB
MONGO_URI=mongodb://localhost:27017/medical-ai

# JWT Secret (change this to a random 64-char string in production)
JWT_SECRET=change_me_in_production_use_a_very_long_random_string

# Server
PORT=5000

# Super Admin initial credentials (used by seed.ts)
# Change BEFORE running the seed script in production!
SUPER_ADMIN_EMAIL=admin@medical-ai.com
SUPER_ADMIN_PASSWORD=admin123

# AI Provider — Phase 6.3
# All three variables must be set for the AI suggestion endpoint to work.
# Leave empty to disable AI (endpoint returns 503 AI service not configured).
# The provider must support the OpenAI Chat Completions API format.
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=

# Meta WhatsApp Cloud API
# Required for real webhook security and WhatsApp integration.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
CORS_ORIGIN=http://localhost:5173

# Keep demo account creation disabled unless explicitly needed for local testing.
ENABLE_DEMO_REGISTRATION=false
